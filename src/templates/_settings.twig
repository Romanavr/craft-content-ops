{# @var plugin \romanavr\contentops\ContentOps #}
{# @var settings \romanavr\contentops\models\Settings #}

{% import '_includes/forms.twig' as forms %}

{{ forms.lightswitchField({
    label: 'Create revisions'|t('content-ops'),
    instructions: 'Whether each save creates an entry revision noted with the changeset ID. Slower, but a second safety net next to undo.'|t('content-ops'),
    name: 'createRevisions',
    on: settings.createRevisions,
}) }}

{{ forms.textField({
    label: 'Batch size'|t('content-ops'),
    instructions: 'How many elements each background job batch processes.'|t('content-ops'),
    name: 'batchSize',
    type: 'number',
    min: 1,
    max: 1000,
    value: settings.batchSize,
    errors: settings.getErrors('batchSize'),
}) }}

{{ forms.textField({
    label: 'History retention (days)'|t('content-ops'),
    instructions: plugin.isPro()
        ? 'Changesets older than this are deleted and can no longer be undone. Leave blank to keep them forever.'|t('content-ops')
        : 'Content Ops Lite keeps 30 days of history. Setting the retention period is available in Content Ops Pro.'|t('content-ops'),
    disabled: not plugin.isPro(),
    name: 'historyRetentionDays',
    type: 'number',
    min: 1,
    value: settings.historyRetentionDays,
    errors: settings.getErrors('historyRetentionDays'),
}) }}

{{ forms.textareaField({
    label: 'AI context'|t('content-ops'),
    instructions: 'Notes for AI tools connected over MCP: tone of voice, naming rules, sections they must not change… Shared with every AI session as `project://context`.'|t('content-ops'),
    name: 'aiContext',
    value: settings.aiContext,
    rows: 6,
}) }}

{{ forms.textField({
    label: 'Max items per AI changeset'|t('content-ops'),
    instructions: 'Proposals over MCP that would change more than this are refused.'|t('content-ops'),
    name: 'mcpMaxElements',
    type: 'number',
    min: 1,
    value: settings.mcpMaxElements,
    errors: settings.getErrors('mcpMaxElements'),
}) }}
