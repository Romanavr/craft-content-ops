{% extends '_layouts/cp.twig' %}
{% import 'content-ops/_macros.twig' as co %}

{% set title = 'Content Ops History'|t('content-ops') %}
{% set selectedSubnavItem = 'history' %}

{% block content %}
  <nav class="co-filters" aria-label="{{ 'Filter'|t('app') }}">
    <a class="btn small{{ not awaitingReview ? ' active' }}" href="{{ cpUrl('content-ops/history') }}">{{ 'All'|t('app') }}</a>
    <a class="btn small{{ awaitingReview ? ' active' }}" href="{{ cpUrl('content-ops/history', {awaiting: 1}) }}">{{ 'AI proposals awaiting review'|t('content-ops') }} ({{ awaitingCount }})</a>
  </nav>
  {% if changesets is empty %}
    <p class="zilch">{{ 'No changesets yet. Use the “Bulk edit” button below any entry list, or Find & Replace.'|t('content-ops') }}</p>
  {% else %}
    <div class="tableview">
      <table class="data fullwidth co-history">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">{{ 'Status'|t('app') }}</th>
            <th scope="col">{{ 'Changes'|t('content-ops') }}</th>
            <th scope="col">{{ 'Result'|t('content-ops') }}</th>
            <th scope="col">{{ 'User'|t('app') }}</th>
            <th scope="col">{{ 'Date Created'|t('app') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for changeset in changesets %}
            <tr>
              <td><a href="{{ cpUrl('content-ops/history/' ~ changeset.id) }}">#{{ changeset.id }}</a></td>
              <td>{{ co.changesetStatus(changeset.status.value) }}</td>
              <td class="co-ops">{{ co.operations(changeset) }}</td>
              <td class="light">{{ co.counts(changeset) }}</td>
              <td>{{ users[changeset.userId] is defined ? users[changeset.userId].friendlyName : (changeset.userId ? 'Deleted user'|t('content-ops') : 'Console'|t('content-ops')) }} {{ co.source(changeset) }}</td>
              <td>{{ changeset.dateCreated|datetime('short') }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
      <div class="flex co-pagination">
        {% if page > 1 %}<a class="btn" href="{{ url(craft.app.request.pathInfo, {page: page - 1}) }}">{{ 'Previous'|t('app') }}</a>{% endif %}
        <span class="light">{{ 'Page {page} of {total}'|t('content-ops', {page: page, total: totalPages}) }}</span>
        {% if page < totalPages %}<a class="btn" href="{{ url(craft.app.request.pathInfo, {page: page + 1}) }}">{{ 'Next'|t('app') }}</a>{% endif %}
      </div>
    {% endif %}
  {% endif %}
{% endblock %}

{% css %}
  .co-history td { vertical-align: top; }
  .co-history .co-ops { max-width: 420px; }
  .co-status { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .co-pagination { margin-top: 16px; gap: 12px; align-items: center; }
  .co-filters { display: flex; gap: 6px; margin-bottom: 14px; }
  .co-filters .btn.active { background: var(--gray-200, #dfe5ec); }
  .co-ai-badge { font-size: 11px; padding: 1px 6px; border-radius: 8px; background: #efe7ff; color: #5b2bb5; white-space: nowrap; }
{% endcss %}
