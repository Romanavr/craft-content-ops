{% extends '_layouts/cp.twig' %}
{% import '_includes/forms.twig' as forms %}
{% import 'content-ops/_macros.twig' as co %}
{% set isPro = craft.app.plugins.getPlugin('content-ops').isPro() %}

{% set title = 'Find & Replace'|t('content-ops') %}
{% set selectedSubnavItem = 'find-replace' %}

{% block content %}
  <form method="post" accept-charset="UTF-8" class="co-fr-form">
    {{ csrfInput() }}
    {{ actionInput('content-ops/find-replace/search') }}

    {{ forms.textField({
      label: 'Find'|t('content-ops'),
      name: 'find',
      value: spec.find,
      required: true,
      autofocus: true,
      code: spec.regex,
    }) }}

    {{ forms.textField({
      label: 'Replace with'|t('content-ops'),
      instructions: 'With regular expressions, use $1, $2… to insert captured groups.'|t('content-ops'),
      name: 'replace',
      value: spec.replace,
    }) }}

    <fieldset class="co-fr-options">
      <legend class="h6">{{ 'Options'|t('content-ops') }}</legend>
      {{ forms.checkbox({label: 'Case-sensitive'|t('content-ops'), name: 'caseSensitive', checked: spec.caseSensitive}) }}
      {{ forms.checkbox({label: 'Whole words only'|t('content-ops'), name: 'wholeWord', checked: spec.wholeWord}) }}
      <div class="co-pro-option">
        {{ forms.checkbox({label: 'Regular expression'|t('content-ops'), name: 'regex', checked: isPro and spec.regex, disabled: not isPro}) }}{% if not isPro %}{{ co.proBadge() }}{% endif %}
      </div>
      <div class="co-pro-option">
        {{ forms.checkbox({label: 'Include links and image URLs'|t('content-ops'), name: 'links', checked: isPro and spec.html == 'textAndLinks', disabled: not isPro}) }}{% if not isPro %}{{ co.proBadge() }}{% endif %}
        <div class="co-option-note">{{ 'Also changes href and src values, e.g. when moving to a new domain.'|t('content-ops') }}</div>
      </div>
      <div class="co-pro-option">
        {{ forms.checkbox({label: 'Include nested entries (Matrix)'|t('content-ops'), name: 'includeNested', checked: isPro and scope.includeNested, disabled: not isPro}) }}{% if not isPro %}{{ co.proBadge() }}{% endif %}
      </div>
    </fieldset>
    {% if not isPro %}
      <p class="light">{{ 'Content Ops Pro adds regular expressions, links and image URLs, Matrix support and choosing individual matches.'|t('content-ops') }}</p>
    {% endif %}

    {{ forms.checkboxSelectField({
      label: 'Sections'|t('app'),
      instructions: 'Leave all unchecked to search every section.'|t('content-ops'),
      name: 'sections',
      options: sections|map(s => {label: s.name, value: s.handle}),
      values: scope.sections,
      showAllOption: false,
    }) }}

    {% if sites|length > 1 %}
      {{ forms.checkboxSelectField({
        label: 'Sites'|t('app'),
        instructions: 'Leave all unchecked to search every site.'|t('content-ops'),
        name: 'siteIds',
        options: sites|map(s => {label: s.name, value: s.id}),
        values: scope.siteIds,
        showAllOption: false,
      }) }}
    {% endif %}

    <ul class="co-fr-notes light">
      <li>{{ 'Searches titles, Plain Text and CKEditor fields.'|t('content-ops') }}</li>
      <li>{{ 'In CKEditor, only visible text changes. HTML tags and reference tags are never touched.'|t('content-ops') }}</li>
      <li>{{ 'Nothing is saved until you’ve reviewed the matches and applied them.'|t('content-ops') }}</li>
    </ul>

    <button type="submit" class="btn submit">{{ 'Find matches'|t('content-ops') }}</button>
  </form>
{% endblock %}

{% css %}
  .co-fr-form { max-width: 720px; }
  .co-fr-options { border: 0; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 6px; }
  .co-pro-option { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; }
  .co-option-note { flex-basis: 100%; padding-left: 26px; font-size: 12px; color: var(--light-text-color, #606d7b); }
  .co-fr-notes { list-style: disc; padding-left: 18px; margin: 0 0 20px; }
  .co-pro-badge { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; padding: 1px 6px; border-radius: 8px; background: var(--blue-050, #e3f0fe); color: var(--blue-800, #1e4b8c); }
{% endcss %}
